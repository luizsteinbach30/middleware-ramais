# =============================================================================
# Middleware USCall Monitor — environment template
# Copie para .env e ajuste. NUNCA commite o .env real.
# =============================================================================

# Servidor HTTP
APP_HOST=0.0.0.0
APP_PORT=8080

# Diretórios persistentes (criados pelo instalador)
# Linux:   /var/lib/middleware-monitor
# Windows: C:\ProgramData\MiddlewareMonitor
APP_DATA_DIR=./data

# Conexão DB (default: sqlite no APP_DATA_DIR/db/app.db)
# Deixe em branco para autocomputar a partir de APP_DATA_DIR.
APP_DB_URL=

# Chave secreta — derivada para sessão, CSRF e cripto em repouso.
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change-me-please-generate-with-secrets-token-urlsafe-64

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# Cookies em produção devem ser Secure (https). Em dev local, deixe false.
APP_COOKIE_SECURE=false

# Auto-update — repositório fonte (NÃO mude em produção)
APP_UPDATE_REPO=luizsteinbach30/middleware-ramais
APP_UPDATE_CHANNEL=stable
APP_UPDATE_CHECK_MINUTES=60
APP_UPDATE_PUBLIC_KEY_PATH=
# Token de leitura das releases (repo privado). Deixe vazio para usar o token
# embutido no build; preencha apenas para rotação (ver docs/RUNBOOK.md §4.1).
APP_UPDATE_TOKEN=

# Métricas Prometheus (opt-in)
APP_METRICS_ENABLED=false
