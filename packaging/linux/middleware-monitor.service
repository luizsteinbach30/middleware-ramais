[Unit]
Description=Middleware USCall Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mmonitor
Group=mmonitor
WorkingDirectory=/opt/middleware-monitor/current
EnvironmentFile=/etc/middleware-monitor/env
# Runtime próprio (CPython + dependências) instalado pelo .run — nada do
# python3 do sistema. O código vem do pacote instalado nesse runtime.
ExecStart=/opt/middleware-monitor/python/bin/python3 -m middleware_monitor
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
# /opt fica somente-leitura para o serviço: quem atualiza é a unidade
# middleware-monitor-update (root), nunca o próprio processo.
ProtectSystem=strict
ReadWritePaths=/var/lib/middleware-monitor
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
