[Unit]
Description=Middleware USCall Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mmonitor
Group=mmonitor
WorkingDirectory=/opt/middleware-monitor/current
EnvironmentFile=/etc/middleware-monitor/env
# Runtime próprio (CPython + dependências) instalado pelo .run — nada do
# python3 do sistema. O código vem do pacote instalado nesse runtime.
ExecStart=/opt/middleware-monitor/python/bin/python3 -m middleware_monitor
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
# /opt fica somente-leitura para o serviço: quem atualiza é a unidade
# middleware-monitor-update (root), nunca o próprio processo.
ProtectSystem=strict
ReadWritePaths=/var/lib/middleware-monitor
NoNewPrivileges=yes
PrivateTmp=yes
# O monitor pinga os telefones com /usr/bin/ping. NoNewPrivileges ignora a
# capability de arquivo do binário (cap_net_raw=ep), e o ICMP sem privilégio
# depende do sysctl net.ipv4.ping_group_range — que num host do cliente estava
# "1 0" (desligado): todo aparelho aparecia offline com "socket: Operation not
# permitted" (2026-09-09). A capability ambiente atravessa o execve mesmo sob
# NoNewPrivileges e não depende do sysctl. É a única que o serviço recebe.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
